<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Regresión completa. Cada bloque <test> corre después del anterior; sus métodos corren en paralelo. -->
<suite name="Web Automation - Regression" parallel="methods" thread-count="4">
    <test name="SauceDemo - E2E flows">
        <packages>
            <package name="com.automation.saucedemo.tests"/>
        </packages>
    </test>
    <test name="The Internet - UI techniques">
        <packages>
            <package name="com.automation.theinternet.tests"/>
        </packages>
    </test>
</suite>
